# Copier ce fichier en .env et adapter les valeurs pour la production
DJANGO_SECRET_KEY=change-me-generate-a-real-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=votredomaine.com,www.votredomaine.com
CORS_ALLOWED_ORIGINS=https://votredomaine.com

# Base de données PostgreSQL en production (recommandé pour un usage international)
DATABASE_URL=postgres://user:password@host:5432/labquality

# E-mail (confirmations de rendez-vous)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.votrefournisseur.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@votredomaine.com
EMAIL_HOST_PASSWORD=votre-mot-de-passe
DEFAULT_FROM_EMAIL=no-reply@votredomaine.com
